# environments and caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# generated results: keep only the top-level summary of each run directory (CLAUDE.md)
results/**
!results/.gitkeep
!results/*/
!results/*/*/
!results/*/*/summary.md

# default outputs of `launchsim animate` and `launchsim replay` (written to the current directory)
*_animation.mp4
*_animation.gif
*_replay.html

# the GitHub Pages site, built by site/build.py (deployed by .github/workflows/pages.yml)
_site/
