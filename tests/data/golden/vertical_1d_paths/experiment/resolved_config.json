{
 "experiment": "vertical_1d_paths",
 "comparison_basis": "Comparison basis: sweep-optimized (Phase 1 has no guidance parameters); 1-D vertical, vacuum thrust, no drag, no rotation, no throttling",
 "baseline": "pad",
 "vehicle": {
  "name": "generic_f9_class",
  "description": "Generic Falcon 9-class two-stage vehicle for the launch-assist screening.",
  "stages": [
   {
    "name": "stage1",
    "dry_mass_t": {
     "value": 25.6,
     "assumed": true,
     "note": "README assumption; SpaceX does not publish it"
    },
    "propellant_mass_t": {
     "value": 395.7,
     "assumed": true,
     "note": "README generic F9-class load; FT spec sheets give 410.9 t (287.4 LOX + 123.5 RP-1); re-source in the Phase 2 calibration fork"
    },
    "engine": {
     "count": {
      "value": 9,
      "source": "spacex.com Falcon 9 page (9 Merlin 1D)"
     },
     "thrust_vac_kN": {
      "value": 914.1,
      "source": "spacex.com Falcon 9 page, 8,227 kN vacuum / 9 = 914.11, rounded to 0.1 kN"
     },
     "thrust_sl_kN": {
      "value": 845.2,
      "source": "spacex.com Falcon 9 page, 7,607 kN sea level / 9 = 845.22, rounded to 0.1 kN"
     },
     "isp_vac_s": {
      "value": 311,
      "source": "en.wikipedia.org/wiki/SpaceX_Merlin specification table, Merlin 1D vacuum Isp 311 s"
     }
    },
    "startup": {
     "kind": "ramp",
     "t_ramp_s": {
      "value": 2.0,
      "assumed": true,
      "note": "linear ramp; F9 ignites at T-3 s and holds down"
     }
    },
    "coast_before_ignition_s": {
     "value": 0.0,
     "assumed": true,
     "note": "first stage; no coast"
    }
   },
   {
    "name": "stage2",
    "dry_mass_t": {
     "value": 3.9,
     "assumed": true,
     "note": "README generic F9-class value; FT spec sheets give a 4.0 t empty mass; re-source in the Phase 2 calibration fork"
    },
    "propellant_mass_t": {
     "value": 92.67,
     "assumed": true,
     "note": "README generic F9-class load; FT spec sheets give 107.5 t (75.2 LOX + 32.3 RP-1); re-source in the Phase 2 calibration fork"
    },
    "engine": {
     "count": {
      "value": 1,
      "source": "spacex.com Falcon 9 page (1 Merlin Vacuum)"
     },
     "thrust_vac_kN": {
      "value": 981,
      "source": "spacex.com Falcon 9 page, MVac thrust"
     },
     "isp_vac_s": {
      "value": 348,
      "source": "en.wikipedia.org/wiki/Falcon_9 specification table, second-stage Isp 348 s"
     }
    },
    "startup": {
     "kind": "step"
    },
    "coast_before_ignition_s": {
     "value": 3.0,
     "assumed": true,
     "note": "staging coast before MVac ignition"
    }
   }
  ],
  "fairing_mass_t": {
   "value": 1.9,
   "source": "en.wikipedia.org/wiki/Falcon_9, fairing section (approximately 1,900 kg)"
  },
  "payload_mass_t": {
   "value": 22.8,
   "source": "spacex.com Falcon 9 page, LEO expendable"
  },
  "fairing_drop": "staging",
  "screening": {
   "stage_isp_eff_s": [
    {
     "value": 295,
     "assumed": true,
     "note": "README stage-1 average Isp between sea level and vacuum"
    },
    {
     "value": 348,
     "source": "en.wikipedia.org/wiki/Falcon_9 specification table, second-stage Isp 348 s (vacuum stage)"
    }
   ]
  }
 },
 "runs": {
  "pad": {
   "run": {
    "name": "pad",
    "site": {
     "latitude_deg": 28.5,
     "azimuth_deg": 90,
     "include_rotation": false
    },
    "assist": {
     "model": "none"
    },
    "ignition": {
     "stage1": {
      "t_ign_s": -2.0,
      "reference": "release"
     },
     "stage2": {
      "t_ign_s": 0.0
     }
    },
    "end": "all_burnout",
    "integrator": {
     "rtol": 1e-10,
     "sample_dt_s": 0.5
    }
   }
  },
  "pad_apex": {
