# environments and caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# generated results: keep only the top-level summary of each run directory (CLAUDE.md)
results/**
!results/.gitkeep
!results/*/
!results/*/*/
!results/*/*/summary.md

# default outputs of `launchsim animate`, `launchsim replay` and `launchsim scene` (written to the
# current directory), and the scene video of the app
*_animation.mp4
*_animation.gif
*_replay.html
*_scene.html
*_scene.mp4

# the GitHub Pages site, built by site/build.py (deployed by .github/workflows/pages.yml)
_site/
